# Every value here is a placeholder. Server-only values are set as Vercel env
# vars; for local dev put the two VITE_ values in apps/web/.env.local.

# Server-only (Vercel env vars; never prefix with VITE_). `pnpm eval` reads
# ANTHROPIC_API_KEY and API_DATA_GOV_KEY from a root .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
API_DATA_GOV_KEY=

# Client-safe (bundled into the web app)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Set by Vercel on deploys; optional locally (the app shows "dev" without it)
# VERCEL_GIT_COMMIT_SHA=
