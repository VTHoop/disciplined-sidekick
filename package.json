{
  "name": "disciplined-sidekick",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @disciplined-sidekick/web dev",
    "build": "pnpm --filter @disciplined-sidekick/web build",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "verify:build": "node scripts/verify-build.ts",
    "check:rls": "bash scripts/check-rls.sh",
    "check:ai-runs": "bash scripts/check-ai-runs.sh",
    "check:targets": "bash scripts/check-targets.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.0.0",
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "zod": "4.6.7"
  }
}
